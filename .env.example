# AWS credentials and region variables for CDK deployments.
#
# Choose ONE auth strategy:
# 1) Static credentials (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY), or
# 2) Named profile (AWS_PROFILE), or
# 3) Temporary credentials (include AWS_SESSION_TOKEN).

# --- Strategy 1/3: Access keys (static or temporary) ---
AWS_ACCESS_KEY_ID=AKIAEXAMPLE
AWS_SECRET_ACCESS_KEY=example-secret-key
AWS_SESSION_TOKEN=

# --- Strategy 2: Named AWS CLI profile ---
AWS_PROFILE=default

# --- Region defaults ---
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# --- Optional CDK environment overrides ---
# If omitted, CDK uses the caller identity and configured default region.
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-east-1

# ---------------------------------------------------------------------------
# Stytch B2B project credentials
# Found in Stytch Dashboard → API Keys and Connected Apps.
# ---------------------------------------------------------------------------

# From Stytch Dashboard → API Keys
STYTCH_PROJECT_ID=project-test-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
STYTCH_PROJECT_DOMAIN=https://<slug>.customers.stytch.dev
STYTCH_ORG_ID=organization-test-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
STYTCH_PUBLIC_TOKEN=public-token-test-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# From Stytch Dashboard → Connected Apps → your app → Client ID
CONNECTED_APP_CLIENT_ID=connected-app-test-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# AWS resource identifiers (populated after first CDK deploy)
# ---------------------------------------------------------------------------

# OAuth API Gateway URL — set after first deploy (see CDK output: OAuthServerUrl).
# Kept here instead of in CDK to avoid a circular dependency (Lambda env -> API GW URL,
# API GW integration -> Lambda ARN).
OAUTH_LAMBDA_URL=https://<id>.execute-api.<region>.amazonaws.com/

# AgentCore Gateway MCP endpoint — used as the allowed JWT audience.
# Set after first deploy (see CDK output: GatewayArn → derive URL, or check Bedrock console).
AGENTCORE_GATEWAY_URL=https://<id>.gateway.bedrock-agentcore.<region>.amazonaws.com/mcp

# ---------------------------------------------------------------------------
# McpFargateGoogleStack — FastMCP on ECS Fargate behind a public ALB,
# with Google OAuth handled by FastMCP's GoogleProvider (OAuth Proxy pattern).
#
# Leave MCP_PUBLIC_HOSTNAME empty to skip deploying this stack entirely.
# ---------------------------------------------------------------------------

# Public hostname the ALB serves on HTTPS:443.
# IMPORTANT: must be a valid DNS hostname — no underscores (ACM rejects them).
MCP_PUBLIC_HOSTNAME=

# Route53 hosted zone that owns the apex domain.  Must already exist in this
# AWS account before `cdk deploy`; the stack uses HostedZone.from_lookup.
ROUTE53_HOSTED_ZONE_NAME=

# Google OAuth 2.0 Web client_id (create manually in GCP Console; mark the
# consent screen "Internal" or restrict to your Workspace org).
# Authorized redirect URI in GCP must be exactly:
#   https://<MCP_PUBLIC_HOSTNAME>/auth/callback
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Comma-separated list of allowed sign-in domains.
# Workspace accounts are gated by the Google `hd` claim; consumer Gmail
# accounts have no `hd`, so `gmail.com` here falls back to email-domain check.
ALLOWED_WORKSPACE_DOMAINS=gmail.com

# LakeFormation admin allow-list (optional).
# CDK's PutDataLakeSettings REPLACES the admin list every deploy, so any
# admin you want preserved across deploys MUST be listed here.
#
# Set LF_ADMIN_INCLUDE_ROOT=true to keep `arn:aws:iam::<account>:root`
# in the list — useful so logging into the console as root can see LF
# tags and grants.
LF_ADMIN_INCLUDE_ROOT=false

# Comma-separated IAM-ARN suffixes (the portion AFTER `arn:aws:iam::<account>:`).
# Account ID is NOT included — CDK templates it in at deploy time.
# Multiple values: comma-separated, no spaces.
LF_EXTRA_ADMIN_IAM_PATHS=

# NOTE: GOOGLE_CLIENT_SECRET is NOT stored in .env.  After `cdk deploy` the
# CDK creates an empty Secrets Manager secret named
# `mcp-fargate-google/google-client-secret`; populate it once with:
#   aws secretsmanager put-secret-value \
#     --secret-id mcp-fargate-google/google-client-secret \
#     --secret-string '<paste-google-client-secret-here>'
# Then force a service redeploy:
#   aws ecs update-service --cluster <cluster> --service <service> --force-new-deployment
